#. Plugin Name of the plugin
#: sgr-nextpage-titles.php classes/class-mpp-admin.php:159
msgid "Multipage"
msgstr "Multipage"

#. Plugin URI of the plugin
#: sgr-nextpage-titles.php
msgid "https://wordpress.org/plugins/sgr-nextpage-titles/"
msgstr "https://es.wordpress.org/plugins/sgr-nextpage-titles/"

#. Description of the plugin
#: sgr-nextpage-titles.php
msgid "Split your WordPress posts into multiple subpages, each with its own title and an automatic table of contents. Supports Gutenberg blocks, classic editor shortcodes, SEO-friendly markup, and customizable navigation."
msgstr "Divide tus entradas de WordPress en varias subpáginas, cada una con su propio título y una tabla de contenidos automática. Compatible con los bloques de Gutenberg, los shortcodes del editor clásico, un marcado optimizado para SEO y una navegación personalizable."

#. Author of the plugin
#: sgr-nextpage-titles.php
msgid "Paul ARGOUD, based on an original idea by SGr33n (aka Sergio De Falco, Envire Web Solutions)."
msgstr "Paul ARGOUD, basado en una idea original de SGr33n (alias Sergio De Falco, Envire Web Solutions)."

#. Author URI of the plugin
#: sgr-nextpage-titles.php
msgid "https://paul.argoud.net"
msgstr "https://paul.argoud.net"

