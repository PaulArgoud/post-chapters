#: inc/admin/admin-advanced-settings.php:132
msgid "Subpage index"
msgstr "Índice de subpáginas"

#: inc/admin/admin-advanced-settings.php:134
msgid "Multipage stores the list of subpages of each post when the post is saved. Rebuild this index after an update, an import, or if the table of contents of a post looks out of date. Posts are processed in batches; on large sites the remaining posts are processed in the background."
msgstr "Multipage guarda la lista de subpáginas de cada entrada cuando se guarda la entrada. Reconstruye este índice después de una actualización o de una importación, o si la tabla de contenidos de una entrada parece desactualizada. Las entradas se procesan por lotes; en sitios grandes, las entradas restantes se procesan en segundo plano."

#. translators: %s: number of posts already checked.
#: inc/admin/admin-advanced-settings.php:144
#, php-format
msgid "A rebuild is in progress in the background: %s post checked so far."
msgid_plural "A rebuild is in progress in the background: %s posts checked so far."
msgstr[0] "Hay una reconstrucción en curso en segundo plano: %s entrada comprobada hasta ahora."
msgstr[1] "Hay una reconstrucción en curso en segundo plano: %s entradas comprobadas hasta ahora."

