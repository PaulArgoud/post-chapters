msgid_plural "%s stale entries removed"
msgstr[0] "%s veralteter Eintrag entfernt"
msgstr[1] "%s veraltete Einträge entfernt"

#. translators: 1: count of posts checked, such as 12 posts checked. 2: count of posts updated, such as 3 posts updated. 3: count of stale entries removed, such as 1 stale entry removed.
#: inc/admin/admin-advanced-settings.php:277
#, php-format
msgid "Subpage index rebuilt: %1$s, %2$s, %3$s."
msgstr "Unterseiten-Index neu aufgebaut: %1$s, %2$s, %3$s."

#. translators: 1: count of posts checked, such as 12 posts checked. 2: count of posts updated, such as 3 posts updated. 3: count of stale entries removed, such as 1 stale entry removed.
#: inc/admin/admin-advanced-settings.php:286
#, php-format
msgid "Subpage index rebuild started: %1$s, %2$s, %3$s so far. The remaining posts are processed in the background."
msgstr "Neuaufbau des Unterseiten-Index gestartet: bisher %1$s, %2$s, %3$s. Die verbleibenden Beiträge werden im Hintergrund verarbeitet."

#: inc/admin/admin-advanced-settings.php:293
msgid "A subpage index rebuild is already running. Please try again in a few minutes."
msgstr "Ein Neuaufbau des Unterseiten-Index läuft bereits. Bitte versuche es in ein paar Minuten erneut."

