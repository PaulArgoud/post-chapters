msgstr "Se i commenti sono abilitati, all’interno dell’indice verrà mostrato un link all’elenco dei commenti."

#: inc/admin/admin-settings.php:224
msgid "Rewrite Title Priority"
msgstr "Priorità di riscrittura del titolo"

#: inc/admin/admin-settings.php:227
msgid "Some plugins need this higher in order to correctly show the chapter title instead of \"Page # of #\". If the title works good please leave this to normal."
msgstr "Alcuni plugin richiedono un valore più alto per mostrare correttamente il titolo del capitolo al posto di “Pagina # di #”. Se il titolo viene mostrato correttamente, lascia questo valore su “Normale”."

#: inc/admin/admin-settings.php:232
msgid "Rewrite Content Priority"
msgstr "Priorità di riscrittura del contenuto"

#. translators: %1$s: URL of the_content filter documentation.
#: inc/admin/admin-settings.php:237
#, php-format
msgid "This value affects the position where the table of contents is displayed, referring to other plugins that use <code><a href=\"%1$s\" target=\"_blank\">the_content</a></code> filter. e.g. above or below social buttons or related posts. If the table of contents position looks good please leave this to normal."
msgstr "Questo valore determina la posizione in cui viene mostrato l’indice rispetto ad altri plugin che usano il filtro <code><a href=\"%1$s\" target=\"_blank\">the_content</a></code>, ad esempio sopra o sotto i pulsanti di condivisione sui social o gli articoli correlati. Se la posizione dell’indice va bene, lascia questo valore su “Normale”."

#: inc/admin/admin-settings.php:244 inc/admin/admin-settings.php:247
msgid "Disable TinyMCE Buttons"
msgstr "Disattiva i pulsanti di TinyMCE"

#: inc/admin/admin-settings.php:248
msgid "Disable the TinyMCE Chapter button in the classic editor. Leave unchecked unless you experience editor conflicts."
msgstr "Disattiva il pulsante Capitolo di TinyMCE nell’editor classico. Lascia la casella deselezionata, a meno che non si verifichino conflitti con l’editor."

