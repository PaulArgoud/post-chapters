#. Plugin Name of the plugin
#: post-chapters.php classes/class-pchap-admin.php:159
msgid "Post Chapters"
msgstr "Post Chapters"

#. Plugin URI of the plugin
#: post-chapters.php
msgid "https://github.com/PaulArgoud/post-chapters"
msgstr "https://github.com/PaulArgoud/post-chapters"

#. Description of the plugin
#: post-chapters.php
msgid "Split your long WordPress posts into chapters, each on its own page with its own title, and add an automatic table of contents. Supports Gutenberg blocks, classic editor shortcodes, SEO-friendly markup, and customizable navigation."
msgstr "Dividi i tuoi articoli WordPress lunghi in capitoli, ognuno su una propria pagina e con il proprio titolo, e aggiungi un indice automatico. Supporta i blocchi di Gutenberg, gli shortcode dell’editor classico, un markup ottimizzato per la SEO e una navigazione personalizzabile."

#. Author of the plugin
#: post-chapters.php
msgid "Paul ARGOUD, based on Multipage by SGr33n (aka Sergio De Falco, Envire Web Solutions)."
msgstr "Paul ARGOUD, basato su Multipage di SGr33n (alias Sergio De Falco, Envire Web Solutions)."

