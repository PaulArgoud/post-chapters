#. Plugin Name of the plugin
#: post-chapters.php classes/class-pchap-admin.php:159
msgid "Post Chapters"
msgstr "Post Chapters"

#. Plugin URI of the plugin
#: post-chapters.php
msgid "https://github.com/PaulArgoud/post-chapters"
msgstr "https://github.com/PaulArgoud/post-chapters"

#. Description of the plugin
#: post-chapters.php
msgid "Split your long WordPress posts into chapters, each on its own page with its own title, and add an automatic table of contents. Supports Gutenberg blocks, classic editor shortcodes, SEO-friendly markup, and customizable navigation."
msgstr "Divisez vos longs articles WordPress en chapitres, chacun sur sa propre page avec son propre titre, et ajoutez une table des matières automatique. Prend en charge les blocs Gutenberg, les codes courts de l’éditeur classique, un balisage optimisé pour le référencement et une navigation personnalisable."

#. Author of the plugin
#: post-chapters.php
msgid "Paul ARGOUD, based on Multipage by SGr33n (aka Sergio De Falco, Envire Web Solutions)."
msgstr "Paul ARGOUD, d’après Multipage de SGr33n (alias Sergio De Falco, Envire Web Solutions)."

