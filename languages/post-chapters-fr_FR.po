#. Plugin Name of the plugin
#: sgr-nextpage-titles.php classes/class-mpp-admin.php:159
msgid "Multipage"
msgstr "Multipage"

#. Plugin URI of the plugin
#: sgr-nextpage-titles.php
msgid "https://wordpress.org/plugins/sgr-nextpage-titles/"
msgstr "https://fr.wordpress.org/plugins/sgr-nextpage-titles/"

#. Description of the plugin
#: sgr-nextpage-titles.php
msgid "Split your WordPress posts into multiple subpages, each with its own title and an automatic table of contents. Supports Gutenberg blocks, classic editor shortcodes, SEO-friendly markup, and customizable navigation."
msgstr "Divisez vos articles WordPress en plusieurs sous-pages, chacune avec son propre titre et une table des matières automatique. Prend en charge les blocs Gutenberg, les codes courts de l’éditeur classique, un balisage optimisé pour le référencement et une navigation personnalisable."

#. Author of the plugin
#: sgr-nextpage-titles.php
msgid "Paul ARGOUD, based on an original idea by SGr33n (aka Sergio De Falco, Envire Web Solutions)."
msgstr "Paul ARGOUD, d’après une idée originale de SGr33n (alias Sergio De Falco, Envire Web Solutions)."

#. Author URI of the plugin
#: sgr-nextpage-titles.php
msgid "https://paul.argoud.net"
msgstr "https://paul.argoud.net"

